<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tech.cumlaude.cakman.cakman.controller.MainMenuController">
   <children>
      <ImageView fitHeight="1024.0" fitWidth="1024.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/background/main_menu.png" />
         </image>
      </ImageView>
      <VBox alignment="BOTTOM_CENTER" spacing="10.0" StackPane.alignment="BOTTOM_CENTER">
         <padding>
            <Insets bottom="80.0" />
         </padding>
         <children>
            <TextField fx:id="txtPlayerName" alignment="CENTER" maxWidth="280.0" prefWidth="280.0" promptText="Masukkan nama pemain"
                       style="-fx-background-color: rgba(0,0,0,0.65); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.7); -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #00FFFF; -fx-border-width: 2; -fx-padding: 10 12 10 12;" />
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="40.0">
               <children>
                  <Button fx:id="btnScore" mnemonicParsing="false" style="-fx-background-color: transparent;">
                     <graphic>
                        <ImageView fitHeight="80.0" fitWidth="152.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/button/score.png" />
                           </image>
                        </ImageView>
                     </graphic>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                  <Button fx:id="btnPlay" mnemonicParsing="false" onAction="#onPlayClick" style="-fx-background-color: transparent;">
                     <graphic>
                        <ImageView fitHeight="80.0" fitWidth="138.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/button/play.png" />
                           </image>
                        </ImageView>
                     </graphic>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                  <Button fx:id="btnExit" mnemonicParsing="false" onAction="#onExitClick" style="-fx-background-color: transparent;">
                     <graphic>
                        <ImageView fitHeight="80.0" fitWidth="152.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/button/exit.png" />
                           </image>
                        </ImageView>
                     </graphic>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
               </children>
            </HBox>
            <Button fx:id="btnMusic" mnemonicParsing="false" onAction="#onMusicClick" style="-fx-background-color: transparent;">
               <graphic>
                  <ImageView fitHeight="60.0" fitWidth="59.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/button/music_on.png" />
                     </image>
                  </ImageView>
               </graphic>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
         </children>
      </VBox>
   </children>
</StackPane>
