<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tech.cumlaude.cakman.cakman.controller.LeaderboardController">
   <children>
      <ImageView fitHeight="1024.0" fitWidth="1024.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/background/main_menu.png" />
         </image>
      </ImageView>
      <VBox alignment="CENTER" spacing="30.0">
         <padding>
            <Insets top="50.0" bottom="50.0" />
         </padding>
         <children>
            <Label text="🏆  PAPAN PERINGKAT  🏆" style="-fx-font-size:48px; -fx-text-fill:#FFD700; -fx-font-weight:bold; -fx-effect:dropshadow(gaussian,black,12,0.6,0,2);" />
            <ScrollPane prefHeight="400.0" style="-fx-background-color: transparent; -fx-padding: 0; -fx-border-color: transparent; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;">
               <VBox fx:id="scoresContainer" spacing="15.0" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: transparent;">
                  <padding>
                     <Insets left="20.0" right="20.0" />
                  </padding>
               </VBox>
            </ScrollPane>
            <Button fx:id="btnBack" mnemonicParsing="false" text="🏠  Kembali ke Menu"
                   style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:white; -fx-background-color:#1a1a4e; -fx-border-color:#00FFFF; -fx-border-width:2; -fx-border-radius:8; -fx-background-radius:8; -fx-padding:12 40 12 40; -fx-cursor:hand;" />
         </children>
      </VBox>
   </children>
</StackPane>

